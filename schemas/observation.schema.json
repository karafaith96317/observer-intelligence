{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://observer-intelligence.org/schemas/observation.schema.json",
  "title": "Observer Intelligence Observation Record",
  "type": "object",
  "required": ["observation_id", "observer_id", "timestamp", "epistemic_label", "content"],
  "properties": {
    "observation_id": {"type": "string"},
    "observer_id": {"type": "string"},
    "timestamp": {"type": "string", "format": "date-time"},
    "modality": {"type": "string"},
    "content": {},
    "epistemic_label": {
      "type": "string",
      "enum": [
        "direct_observation",
        "subjective_report",
        "externally_verified",
        "inference",
        "hypothesis",
        "prediction",
        "symbolic_interpretation",
        "simulated_result",
        "unresolved_contradiction"
      ]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "context": {"type": "object"},
    "provenance": {"type": "array", "items": {"type": "string"}},
    "corroborates": {"type": "array", "items": {"type": "string"}},
    "contradicts": {"type": "array", "items": {"type": "string"}},
    "interpretation": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
